# 配置后"查看作品"会绕过 Railway /api/static/... 直接访问 COS 静态网站（之前会 404）。
VITE_COS_DEPLOY_HOST=https://xiaolou-bi-1382226492.cos-website.ap-shanghai.myqcloud.com